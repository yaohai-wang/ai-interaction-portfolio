{
  "name": "kai-ai-interaction-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check.mjs",
    "build:release": "node scripts/prepare.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check.mjs --release",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "shots": "node scripts/shots.mjs",
    "video": "node scripts/video.mjs",
    "pdf": "node scripts/pdf.mjs",
    "check": "node scripts/check.mjs",
    "qa": "node scripts/qa.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "specs": "node scripts/export-specs.mjs",
    "build:deploy": "npm run build && node scripts/prepare-deploy.mjs"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.65.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}
