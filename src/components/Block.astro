---
import {content} from '../content/schema';
import Flow from './Flow.astro';
import Shot from './Shot.astro';
const {block:b,index=0,print=false}=Astro.props;
const c=content.cases.find(x=>x.slug===b.case);
const href=(slug:string)=>print?`#${content.pages.find(p=>p.case===slug)?.id}`:`/cases/${slug}/`;
const pageOf=(slug:string)=>String(content.pages.findIndex(p=>p.case===slug)+1).padStart(2,'0');
---
<section class:list={['folio-page','revised-page',`layout-${b.type}`,b.variant&&`variant-${b.variant}`]} id={b.id} style={`--accent:${c?.accent||'#617460'}`} data-page={index+1}>
  <div class="page-meta"><span>{b.eyebrow}</span><span class="draft-label">{content.site.draftLabel}</span></div>
  <header class="r-heading"><h1>{b.title}</h1>{b.lead&&<p class="lead">{b.lead}</p>}</header>
  <div class="block-content r-content">
    {b.type==='cover'&&<div class="r-cover"><div class="r-cover-identity"><strong>王耀海</strong><span>KAI WANG</span><p>2027 届 · AI 创新交互设计方向</p><p class="r-cover-project">主打项目 / 理想之家<br/>愿景 → 手记 → 核对 → 空间反馈</p></div><Shot shot={b.shots[0]} print={print}/></div>}
    {b.type==='overview'&&<div class="r-overview"><div class="r-bio">{b.items.map((i:any)=><article><span class="r-kicker">{i.label}</span><h2>{i.title}</h2><p>{i.text}</p></article>)}</div><nav class="r-project-nav" aria-label="项目导航">{content.cases.map(c=><a href={href(c.slug)} style={`--accent:${c.accent}`}><span class="r-nav-number">{c.number} / {c.tag}<span>P{pageOf(c.slug)} ↗</span></span><h2>{c.title}</h2><p>{c.summary}</p><small>{c.status}</small></a>)}</nav></div>}
    {b.type==='hero'&&<div class="r-hero"><div class="r-hero-info">{b.detail&&<p class="r-problem">{b.detail}</p>}<dl>{b.meta.map((m:any)=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>{b.demo&&<a class="r-demo" href={b.demo} target="_blank" rel="noopener noreferrer"><span>打开演示 ↗</span>{b.qr&&<img src={b.qr} width="90" height="90" alt={`${c?.title}演示入口二维码`}/>}</a>}</div><div class="r-hero-visual">{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}{b.video&&!print&&<video controls preload="none" poster={b.poster}><source src={b.video} type="video/mp4"/></video>}</div></div>}
    {b.type==='decision'&&<div class="r-decisions">{b.items.map((i:any,n:number)=><article><span class="r-decision-index">{String(n+1).padStart(2,'0')}</span><div><h2>{i.title}</h2><p>{i.text}</p></div>{i.label&&<aside>{i.label}</aside>}</article>)}</div>}
    {(b.type==='sequence'||b.type==='before-after')&&<div class:list={['r-evidence',`count-${b.shots.length}`]}>{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div>}
    {b.type==='flow'&&<div class="r-flow"><Flow nodes={b.nodes}/>{b.shots.length>0&&<div class="r-flow-shots">{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div>}</div>}
    {b.type==='focus'&&<div class="r-focus"><div class="r-focus-overview"><Shot shot={b.shots[0]} print={print}/>{b.supportShots.map((s:any)=><Shot shot={s} print={print}/>)}{b.items.map((i:any)=><article><h2>{i.title}</h2><p>{i.text}</p></article>)}</div><div class:list={['r-focus-details',`count-${b.shots.length-1}`]}>{b.shots.slice(1).map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div></div>}
    {b.type==='desktop'&&<div class="r-desktop"><div class="r-desktop-main"><Shot shot={b.shots[0]} print={print}/><div class="r-theme-strip">{b.shots.slice(1,5).map((s:any)=><Shot shot={s} print={print}/>)}</div></div><div class="r-desktop-task">{b.shots.slice(5).map((s:any)=><Shot shot={s} print={print}/>)}{b.items.map((i:any)=><article><h2>{i.title}</h2><p>{i.text}</p></article>)}{b.demo&&<a class="r-demo" href={b.demo}>打开桌面 ↗<img src={b.qr} width="68" height="68" alt="桌面演示二维码"/></a>}</div></div>}
    {b.type==='closing'&&<div class="r-closing"><div><p class="r-signature">王耀海<span>Kai Wang</span></p><p>{b.detail}</p></div><div class="r-closing-links">{content.cases.filter(c=>c.demo).map(c=><div><span>{c.title}</span><a href={c.demo}>{new URL(c.demo!).hostname} ↗</a><img src={c.qr} width="90" height="90" alt={`${c.title}演示二维码`}/></div>)}</div></div>}
    {b.items.length>0&&['sequence','before-after','flow'].includes(b.type)&&<div class:list={['r-notes',`count-${b.items.length}`]}>{b.items.map((i:any)=><article><span class="r-kicker">{i.label}</span><h2>{i.title}</h2><p>{i.text}</p></article>)}</div>}
    {b.callout&&<p class="r-callout">{b.callout}</p>}
  </div>
  <footer class="page-foot"><span>{b.source}</span><span>{String(index+1).padStart(2,'0')} / {String(content.pages.length).padStart(2,'0')}</span></footer>
</section>
