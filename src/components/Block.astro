---
import {content} from '../content/schema';
import Shot from './Shot.astro';
import Constellation from './Constellation.astro';
const {block:b,index=0,print=false}=Astro.props;
const c=content.cases.find(x=>x.slug===b.case);
const href=(slug:string)=>print?`#${content.pages.find(p=>p.case===slug)?.id}`:`/cases/${slug}/`;
const pageOf=(slug:string)=>String(content.pages.findIndex(p=>p.case===slug)+1).padStart(2,'0');
const thumbs=Object.fromEntries(content.cases.map(c=>[c.slug,content.pages.find(p=>p.case===c.slug)?.shots[0]?.src]));
---
<section class:list={['folio-page','revised-page',`layout-${b.type}`,b.variant&&`variant-${b.variant}`]} id={b.id} data-page={index+1}>
  <div class="page-meta"><span>{b.eyebrow}</span><span class="draft-label">{content.site.draftLabel}</span></div>
  {b.type!=='cover'&&<header class="r-heading"><h1>{b.title}</h1>{b.lead&&<p class="lead">{b.lead}</p>}</header>}
  <div class="block-content r-content">
    {b.type==='cover'&&<div class="r-cover"><div class="r-cover-identity"><span class="r-kicker">2027 / SELECTED WORK</span><h1>{b.title}</h1><p class="r-name">王耀海 <span>Kai Wang</span></p><p class="r-cover-description">从生活中的行动，到界面里的选择。<br/>四个关于 AI、空间与信息的设计项目。</p><a class="primary-link" href={print?'#about':'#works'}>查看作品 ↗</a></div><Constellation/></div>}
    {b.type==='overview'&&<div class="r-overview"><div class="r-bio">{b.items.map((i:any)=><article><span class="r-kicker">{i.label}</span><h2>{i.title}</h2><p>{i.text}</p></article>)}</div><nav class="r-project-nav" aria-label="项目导航">{content.cases.map(c=><a href={href(c.slug)}><img class="nav-shot" src={thumbs[c.slug]} width="640" height="400" alt={`${c.title}项目界面`}/><span class="r-nav-number">{c.number}<span>P{pageOf(c.slug)} ↗</span></span><h2>{c.title}</h2><p>{c.summary}</p></a>)}</nav></div>}
    {b.type==='hero'&&<div class="r-hero"><div class="r-hero-info">{b.detail&&<p class="r-problem">{b.detail}</p>}<dl>{b.meta.map((m:any)=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>{b.demo&&<div class="r-demo"><a class="primary-link" href={b.demo} target="_blank" rel="noopener noreferrer">打开项目 ↗</a>{b.qr&&<img src={b.qr} width="84" height="84" alt={`${c?.title}演示入口二维码`}/>}</div>}</div><div class="r-hero-visual">{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}{b.video&&!print&&<video controls preload="none" poster={b.poster}><source src={b.video} type="video/mp4"/></video>}</div></div>}
    {b.type==='decision'&&<div class="r-decisions">{b.items.map((i:any,n:number)=><article><span class="r-decision-index">0{n+1}</span><div><h2>{i.title}</h2><p>{i.text}</p>{i.label&&<aside>{i.label}</aside>}</div></article>)}</div>}
    {(b.type==='sequence'||b.type==='before-after')&&<div class:list={['r-evidence',`count-${b.shots.length}`]}>{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div>}
    {b.type==='flow'&&<div class="r-flow"><ol class="state-axis">{b.nodes.map((n:any,i:number)=><li class:list={{'is-human':n.kind==='human'}}><span>0{i+1}</span><strong>{n.title}</strong><small>{n.detail}</small></li>)}</ol><div class="r-flow-shots">{b.shots.map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div></div>}
    {b.type==='focus'&&<div class="r-focus"><div class="r-focus-overview"><Shot shot={b.shots[0]} print={print}/>{b.supportShots.map((s:any)=><Shot shot={s} print={print}/>)}{b.items.map((i:any)=><article><h2>{i.title}</h2><p>{i.text}</p></article>)}</div><div class="r-focus-details">{b.shots.slice(1).map((s:any)=><Shot shot={s} notes={s.notes} print={print}/>)}</div></div>}
    {b.type==='desktop'&&<div class="r-desktop"><div class="r-desktop-main"><Shot shot={b.shots[0]} print={print}/><div class="r-theme-strip">{b.shots.slice(1,5).map((s:any)=><Shot shot={s} print={print}/>)}</div></div><div class="r-desktop-task">{b.shots.slice(5).map((s:any)=><Shot shot={s} print={print}/>)}{b.items.map((i:any)=><article><h2>{i.title}</h2><p>{i.text}</p></article>)}{b.demo&&<a class="text-link" href={b.demo}>打开桌面 ↗</a>}</div></div>}
    {b.type==='closing'&&<div class="r-closing"><div><p class="r-signature">王耀海<span>Kai Wang</span></p><p>{b.detail}</p></div><div class="r-closing-links">{content.cases.filter(c=>c.demo).map(c=><div><span>{c.title}</span><a href={c.demo}>{new URL(c.demo!).hostname} ↗</a><img src={c.qr} width="90" height="90" alt={`${c.title}演示二维码`}/></div>)}</div></div>}
    {b.items.length>0&&['sequence','before-after','flow'].includes(b.type)&&<div class:list={['r-notes',`count-${b.items.length}`]}>{b.items.map((i:any)=><article><span class="r-kicker">{i.label}</span><h2>{i.title}</h2><p>{i.text}</p></article>)}</div>}
    {b.callout&&<p class="r-callout">{b.callout}</p>}
  </div>
  <footer class="page-foot"><span>{b.source}</span><span>{String(index+1).padStart(2,'0')} / {String(content.pages.length).padStart(2,'0')}</span></footer>
</section>
