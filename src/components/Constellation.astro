---
// Deterministic decorative constellation; no project result is represented here.
let seed=2707;const random=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};
const colors=['#8052ff','#ffb829','#15846e','#bdbdbd','#ffffff'];
const particles=Array.from({length:1050},(_,i)=>{const u=random()*Math.PI*2,v=Math.acos(2*random()-1),r=.78+random()*.22;const lobe=1+.14*Math.cos(u*3)*Math.sin(v*2);const x=520+410*r*Math.sin(v)*Math.cos(u)*lobe,y=370+265*r*Math.cos(v)+38*Math.sin(u*2);const z=Math.sin(v)*Math.sin(u);return {x,y,size:1.7+random()*3.6,color:colors[Math.floor(random()*colors.length)],opacity:.2+(z+1)*.3,rotation:random()*360};});
const ambient=Array.from({length:70},()=>({x:random()*1040,y:random()*740,size:2+random()*3,color:colors[Math.floor(random()*3)]}));
---
<svg class="constellation" viewBox="0 0 1040 740" role="img" aria-label="彩色三角点组成的装饰性星云">
  <g class="constellation-cloud">{particles.map(p=><path d={`M${-p.size} ${p.size} L0 ${-p.size} L${p.size} ${p.size} Z`} fill="none" stroke={p.color} stroke-width=".8" opacity={p.opacity} transform={`translate(${p.x.toFixed(2)} ${p.y.toFixed(2)}) rotate(${p.rotation.toFixed(1)})`}/>)}</g>
  <g opacity=".35">{ambient.map(p=><path d={`M${p.x} ${p.y}l${p.size} ${p.size*1.7}h${-p.size*2}Z`} fill="none" stroke={p.color} stroke-width=".7"/>)}</g>
</svg>
