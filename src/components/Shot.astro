---
import fs from 'node:fs';
const {shot,notes=[],print=false}=Astro.props;const exists=shot?.src&&fs.existsSync('public'+shot.src);const webp=shot?.src?.replace(/\.jpg$/,'.webp');
---
<figure class="shot-figure">
  <div class="shot-wrap">
    {exists?<picture>{!print&&fs.existsSync('public'+webp)&&<source srcset={webp} type="image/webp"/>}<img src={shot.src} alt={shot.alt||shot.caption} loading={print?'eager':'lazy'} width="1440" height="900"/></picture>:<div class="asset-placeholder">素材采集中<span>{shot?.label||shot?.src||'TODO(Kai)'}</span></div>}
    {notes.map((n:any,i:number)=><span class="shot-pin" style={`left:${n.x*100}%;top:${n.y*100}%`} aria-label={`标注 ${i+1}：${n.title}`}>{i+1}</span>)}
  </div>
  <figcaption>{shot?.label&&<b>{shot.label} · </b>}{shot?.caption}</figcaption>
</figure>
