---
const {project:c}=Astro.props;
---
<svg class="project-thumbnail" viewBox="0 0 800 180" role="img" aria-label={`${c.title} · 自制交互结构示意`}>
{c.slug==='agent'&&<g><rect class="thumb-fill" x="54" y="52" width="205" height="75" rx="36"/><path d="M88 78h128m-128 22h80"/><path d="M276 90h48m-12-9 12 9-12 9"/><rect class="thumb-fill" x="343" y="24" width="218" height="130" rx="9"/><rect x="364" y="45" width="16" height="16" rx="3"/><path d="M393 53h139m-168 35h168m-168 27h111"/><path d="M578 90h48m-12-9 12 9-12 9"/><circle class="thumb-accent" cx="696" cy="90" r="57"/><path class="thumb-check" d="m668 91 19 19 37-40"/></g>}
{c.slug==='ideal-home'&&<g><path class="thumb-fill" d="m212 90 180-69 187 70-181 70z"/><path d="M212 90v-65l180-5 187 5v66M392 21v65"/><path class="thumb-accent" d="m293 97 94-35 91 35-95 37z"/><path d="M293 97v29l90 35 95-35V97m-95 37v27"/><path d="m310 87 77 29 73-29m-73 29v21"/><circle cx="121" cy="85" r="32"/><path d="m108 86 9 10 18-22M156 85h31m432 0h59"/><rect class="thumb-fill" x="684" y="52" width="55" height="66" rx="5"/><path d="M696 70h31m-31 16h22m-22 16h28"/></g>}
{c.slug==='pitwall'&&<g><rect class="thumb-fill" x="70" y="24" width="400" height="132" rx="8"/><path d="M70 52h400M94 75h145m-145 23h218m-218 23h192"/><rect x="346" y="72" width="98" height="60" rx="5"/><path d="M487 89h39m-12-9 12 9-12 9"/><rect class="thumb-fill" x="546" y="20" width="183" height="142" rx="11"/><rect class="thumb-accent" x="562" y="36" width="151" height="27" rx="8"/><path d="M564 83h105m-105 22h130"/><rect x="564" y="125" width="149" height="23" rx="5"/></g>}
{c.slug==='desktop'&&<g>{['#bd2636','#50e8f3','#24744d','#f4d44d','#58498f'].map((color,i)=><g transform={`translate(${55+i*142} 28)`}><rect class="thumb-fill" width="122" height="123" rx="5"/><rect x="9" y="9" width="104" height="8" rx="2" fill={color} stroke="none"/><path d="M18 86h86M32 86v21m58-21v21"/><rect x="41" y="36" width="45" height="34" rx="3"/><path d="M63 70v16M53 86h21"/></g>)}</g>}
</svg>
<style>.project-thumbnail{width:100%;height:140px;display:block;margin:18px 0 8px;fill:none;stroke:#76806f;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.thumb-fill{fill:#eeeee7}.thumb-accent{fill:var(--accent);fill-opacity:.16;stroke:var(--accent)}.thumb-check{stroke:var(--ink);stroke-width:4}:global(.print-document) .project-thumbnail{height:84px;margin:10px 0}@media(max-width:600px){.project-thumbnail{height:140px;margin:15px 0}}</style>
