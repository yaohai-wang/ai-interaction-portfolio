---
<!doctype html><html lang="zh-CN" data-locale="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={content.site.description}/><meta name="robots" content="noindex,nofollow"/><meta property="og:title" content={title}/><meta property="og:description" content={content.site.description}/><meta property="og:image" content="/og-image.jpg"/><meta name="theme-color" content="#f7f6f2"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/noto-sc-regular.woff2" as="font" type="font/woff2" crossorigin/></head><body class:list={{'print-document':print}}>
{!print&&<><a class="skip-link" href="#main">跳到正文</a><header class="site-header"><a class="wordmark" href="/">KAI WANG<span>交互设计 / 2027</span></a><nav aria-label="主导航"><a href="/#works">作品</a><a href="/about/">关于</a><a href="/specs/">设计规格</a><a href="/assets-review/">素材审阅</a><span class="language-control" lang="en" title="已预留英文结构，本期未翻译">中 / <span aria-disabled="true">EN</span></span></nav></header></>}
