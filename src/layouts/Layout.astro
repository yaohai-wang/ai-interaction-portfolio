---
import '../styles/global.css';
import '../styles/revision.css';
import {content} from '../content/schema';
import fs from 'node:fs';
const downloadReady=fs.existsSync('public/downloads/portfolio-ai-interaction-revised.pdf');
const {title=content.site.title,print=false}=Astro.props;
---
<!doctype html><html lang="zh-CN" data-locale="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={content.site.description}/><meta name="robots" content="noindex,nofollow"/><meta property="og:title" content={title}/><meta property="og:description" content={content.site.description}/><meta property="og:image" content="/og-image.jpg"/><meta name="theme-color" content="#000000"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/noto-sc-regular.woff2" as="font" type="font/woff2" crossorigin/></head><body class:list={{'print-document':print}}>
{!print&&<><a class="skip-link" href="#main">跳到正文</a><header class="site-header"><a class="wordmark" href="/">KAI WANG<span>交互设计 / 2027</span></a><nav aria-label="主导航"><a href="/#works">作品</a><a href="/about/">关于</a><a href="/cases/pitwall/">F1</a>{downloadReady&&<a class="header-download" href="/downloads/portfolio-ai-interaction-revised.pdf">下载作品集 ↗</a>}<span class="language-control" lang="en" title="已预留英文结构，本期未翻译">中 / <span aria-disabled="true">EN</span></span></nav></header></>}
<main id="main" tabindex="-1"><slot/></main>
{!print&&<footer class="site-footer"><span>王耀海 · AI 交互设计作品集 · 修订预览版</span><span class="footer-links">{downloadReady&&<a href="/downloads/portfolio-ai-interaction-revised.pdf">修订 PDF ↗</a>}<a href="/print/">完整作品集 ↗</a><a href="/assets-review/">素材索引</a></span></footer>}
</body></html>
