---
import Layout from '../../layouts/Layout.astro';import Block from '../../components/Block.astro';import {content} from '../../content/schema';
export function getStaticPaths(){return content.cases.map(c=>({params:{slug:c.slug},props:{c}}));}
const {c}=Astro.props;const pages=content.pages.filter(p=>p.case===c.slug);
---
<Layout title={`${c.title} · 王耀海作品集`}><nav class="case-jump" aria-label="案例目录"><a href="/#works">← 全部作品</a>{pages.map((b,i)=><a href={`#${b.id}`}>{String(i+1).padStart(2,'0')}</a>)}</nav>{pages.map(b=><Block block={b} index={content.pages.indexOf(b)}/>)}</Layout>
