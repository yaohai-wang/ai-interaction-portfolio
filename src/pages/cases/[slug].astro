---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { renderCase, caseSlugs, caseTitle, meta } from '../../site/render.ts';
export function getStaticPaths() {
  return caseSlugs().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
---
<SiteLayout title={caseTitle(slug)} description={meta.description} body={renderCase(slug)} />
