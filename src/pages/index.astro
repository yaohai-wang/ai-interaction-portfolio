---
import Layout from '../layouts/Layout.astro';
import Block from '../components/Block.astro';
import Shot from '../components/Shot.astro';
import {content} from '../content/schema';
const cover=content.pages.find(p=>p.type==='cover');
const hero=(slug:string)=>content.pages.find(p=>p.case===slug);
---
<Layout>
  <Block block={cover} index={0}/>
  <section class="work-list" id="works" aria-labelledby="selected-title">
    <header><span class="r-kicker">SELECTED WORK / 01—04</span><h2 id="selected-title"><span>四个项目，</span><span>四种交互探索。</span></h2></header>
    {content.cases.map((c,i)=><article class:list={['work-feature',i%2===1&&'is-reversed']}>
      <div class="work-feature-copy"><span class="r-kicker">{c.number} / {c.tag}</span><h2>{c.title}</h2><p>{c.summary}</p><span class="work-status">{c.status}</span><a class="text-link" href={`/cases/${c.slug}/`}>查看案例 ↗</a></div>
      <div class="work-feature-image"><Shot shot={hero(c.slug)?.shots[0]}/></div>
    </article>)}
  </section>
</Layout>
